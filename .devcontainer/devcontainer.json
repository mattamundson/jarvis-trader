{
  "name": "jarvis-trader",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "nodeGypDependencies": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "containerEnv": {
    "PYTHONUTF8": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },

  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },

  "mounts": [
    "source=jarvis-trader-venv,target=${containerWorkspaceFolder}/engine/.venv,type=volume",
    "source=jarvis-trader-pnpm-store,target=/home/vscode/.local/share/pnpm/store,type=volume"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "runArgs": ["--cap-drop=ALL", "--cap-add=CHOWN", "--cap-add=DAC_OVERRIDE", "--cap-add=SETUID", "--cap-add=SETGID"],

  "forwardPorts": [8010, 3010],
  "portsAttributes": {
    "8010": {
      "label": "engine-api",
      "onAutoForward": "silent",
      "requireLocalPort": true
    },
    "3010": {
      "label": "dashboard",
      "onAutoForward": "silent",
      "requireLocalPort": true
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/engine/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "ruff.importStrategy": "fromEnvironment",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteUser": "vscode"
}
