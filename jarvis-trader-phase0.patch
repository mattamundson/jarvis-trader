+"""GET /safety/r-lockout: state for the dashboard banner. Fires the daily_loss breaker once."""
+from __future__ import annotations
+
+from datetime import date
+
+from fastapi import APIRouter, Query
+
+from risk.r_lockout import evaluate
+
+router = APIRouter(prefix="/safety", tags=["safety"])
+_emitted: set[date] = set()
+
+
+@router.get("/r-lockout")
+async def r_lockout(day_pnl: float = Query(..., description="Session P&L in $ (RH + IB, entered or synced)")):
+    today = date.today()
+    s = evaluate(day_pnl, today)
+    if s.locked and today not in _emitted:
+        _emitted.add(today)
+        try:  # reuse existing breaker event (see WEBSOCKET.md)
+            from websocket.events import emit_circuit_breaker
+            await emit_circuit_breaker("daily_loss", triggered=True, value=s.day_pnl)
+        except ImportError:
+            pass
+    return {"session": today.isoformat(), "day_pnl": s.day_pnl, "day_r": s.day_r,
+            "stop_r": s.stop_r, "locked": s.locked, "reason": s.reason}
