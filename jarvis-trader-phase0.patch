+"use client";
+// Red banner when the 2R day stop is hit. Polls /safety/r-lockout every 30s.
+import { useEffect, useState } from "react";
+import { fetchEngine } from "@/lib/api";
+
+type Lock = { locked: boolean; day_r: number; stop_r: number; reason: string };
+
+export default function RLockoutBanner({ dayPnl }: { dayPnl: number }) {
+  const [lock, setLock] = useState<Lock | null>(null);
+  useEffect(() => {
+    const load = () =>
+      fetchEngine<Lock>(`/safety/r-lockout?day_pnl=${dayPnl}`)
+        .then(setLock)
+        .catch(() => setLock({ locked: true, day_r: 0, stop_r: 2, reason: "lockout check unreachable" }));
+    load();
+    const t = setInterval(load, 30_000);
+    return () => clearInterval(t);
+  }, [dayPnl]);
+  if (!lock) return null;
+  if (!lock.locked)
+    return <div className="px-3 py-1 text-xs text-zinc-400">Day {lock.day_r.toFixed(2)}R / stop -{lock.stop_r}R</div>;
+  return (
+    <div role="alert" className="w-full bg-red-700 px-4 py-3 text-center font-bold text-white">
+      LOCKED. {lock.reason}. Flat for the rest of the session. No new triggers.
+    </div>
+  );
+}
