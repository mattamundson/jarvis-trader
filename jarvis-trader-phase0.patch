+"""Fixed IB Gateway clientId per job.
+
+One job, one id. Two live sockets with the same id make IB drop one of them
+(10/20/2026: ibkr_check.py and fetch_ib_intraday.py both used 77).
+"""
+from __future__ import annotations
+
+# Engine executor rotates inside this band (restart_engine*.ps1); data leg = executor + 1.
+EXECUTOR_BAND = range(200, 261)
+
+IB_CLIENT_IDS: dict[str, int] = {
+    "executor_default": 1,   # used only when IBKR_CLIENT_ID is unset
+    "data_default": 2,       # executor_default + 1
+    "scanner": 10,
+    "domflow": 11,
+    "backfill": 77,          # fetch_ib_intraday.py
+    "ibkr_check": 81,        # /workspace/gex/ibkr_check.py (was 77)
+    "moc_check": 82,
+    "study_grade": 83,
+    "qqq_z_watch": 84,
+    "research": 99,          # validate_ib_paper.py, _pull_ibkr_bars.py
+}
+
+# Ports that must never carry orders (live Gateway / live TWS).
+LIVE_PORTS = frozenset({4001, 7496})
+
+
+def client_id(job: str) -> int:
+    """Look up a job's fixed id. Unknown job is a bug, so fail loudly."""
+    return IB_CLIENT_IDS[job]
+
+
+def check_registry() -> None:
+    """No duplicates, and nothing inside the executor band."""
+    ids = list(IB_CLIENT_IDS.values())
+    if len(ids) != len(set(ids)):
+        raise ValueError(f"duplicate IB clientId in registry: {ids}")
+    clash = [j for j, i in IB_CLIENT_IDS.items() if i in EXECUTOR_BAND]
+    if clash:
+        raise ValueError(f"clientId inside executor band 200-260: {clash}")
+
+
+def assert_order_port(port: int) -> None:
+    """Refuse any order connection on a live port. Paper is 4002."""
+    if int(port) in LIVE_PORTS:
+        raise ValueError(f"refusing order connection on live port {port}; paper only (4002)")
+
+
+check_registry()
