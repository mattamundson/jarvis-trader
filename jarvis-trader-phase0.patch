+++ b/engine/tests/test_r_lockout.py
@@ -0,0 +1,42 @@
+from datetime import date
+
+import pytest
+
+from risk import r_lockout
+
+SKILL = """| Account equity E | **$5,048** (Robinhood) |
+| R (risk unit) | **10% of E = $505** |
+| Daily max loss → flat rest of session | **2R** | $1,010 |
+"""
+
+
+@pytest.fixture
+def skill(tmp_path):
+    r_lockout.reset_for_tests()
+    p = tmp_path / "SKILL.md"
+    p.write_text(SKILL, encoding="utf-8")
+    return str(p)
+
+
+def test_reads_e_and_r_from_constitution(skill):
+    c = r_lockout.load_constitution(skill)
+    assert (c.equity, c.r_dollars, c.day_stop_r) == (5048.0, 505.0, 2.0)
+
+
+def test_unlocked_above_stop(skill):
+    assert not r_lockout.evaluate(-1000.0, date(2026, 10, 20), skill).locked
+
+
+def test_locks_at_2r_and_latches(skill):
+    d = date(2026, 10, 20)
+    assert r_lockout.evaluate(-1010.0, d, skill).locked
+    # Winning back later the same day does not unlock.
+    assert r_lockout.evaluate(+200.0, d, skill).locked
+    # Next session starts clean.
+    assert not r_lockout.evaluate(0.0, date(2026, 10, 21), skill).locked
+
+
+def test_fails_closed_when_constitution_missing(tmp_path):
+    r_lockout.reset_for_tests()
+    s = r_lockout.evaluate(0.0, date(2026, 10, 20), str(tmp_path / "nope.md"))
+    assert s.locked and "unreadable" in s.reason
