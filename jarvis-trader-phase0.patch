+"""Hard 2R daily-stop lockout.
+
+E and R come from the account-risk-constitution skill, never from code.
+Once day P&L <= -2R the session is LOCKED until the next session date.
+"""
+from __future__ import annotations
+
+import os
+import re
+from dataclasses import dataclass
+from datetime import date
+from pathlib import Path
+
+# Override with ACCOUNT_RISK_CONSTITUTION_PATH on AmoSZN (the skill lives on the box).
+DEFAULT_PATH = "/home/box/sand-data/workflows/account-risk-constitution/SKILL.md"
+
+_E_RE = re.compile(r"Account equity E\s*\|\s*\*\*\$([\d,]+(?:\.\d+)?)\*\*")
+_R_RE = re.compile(r"R \(risk unit\)\s*\|\s*\*\*[^=|]*=\s*\$([\d,]+(?:\.\d+)?)\*\*")
+_DAY_RE = re.compile(r"Daily max loss[^|]*\|\s*\*\*(\d+(?:\.\d+)?)R\*\*")
+
+
+@dataclass(frozen=True)
+class Constitution:
+    equity: float
+    r_dollars: float
+    day_stop_r: float  # e.g. 2.0
+
+
+def load_constitution(path: str | None = None) -> Constitution:
+    """Parse E, R and the daily stop from the constitution table. Missing -> raise."""
+    p = Path(path or os.getenv("ACCOUNT_RISK_CONSTITUTION_PATH", DEFAULT_PATH))
+    text = p.read_text(encoding="utf-8")
+    m_e, m_r, m_d = _E_RE.search(text), _R_RE.search(text), _DAY_RE.search(text)
+    if not (m_e and m_r and m_d):
+        # Unknown E/R means paper-only per the constitution; caller treats as locked.
+        raise ValueError(f"constitution at {p} missing E, R or daily stop")
+    num = lambda m: float(m.group(1).replace(",", ""))  # noqa: E731
+    return Constitution(equity=num(m_e), r_dollars=num(m_r), day_stop_r=num(m_d))
+
+
+@dataclass
+class LockoutState:
+    session: date
+    day_pnl: float
+    day_r: float
+    stop_r: float
+    locked: bool
+    reason: str
+
+
+_latched: dict[date, str] = {}  # once locked, stays locked for that session
+
+
+def evaluate(day_pnl: float, session: date, path: str | None = None) -> LockoutState:
+    """Return lockout state. Fails closed if the constitution can't be read."""
+    try:
+        c = load_constitution(path)
+    except (OSError, ValueError) as e:
+        return LockoutState(session, day_pnl, 0.0, 0.0, True, f"constitution unreadable: {e}")
+    day_r = day_pnl / c.r_dollars if c.r_dollars > 0 else 0.0
+    if day_r <= -c.day_stop_r and session not in _latched:
+        _latched[session] = f"day {day_r:+.2f}R hit {c.day_stop_r:g}R stop"
+    reason = _latched.get(session, "")
+    return LockoutState(session, day_pnl, round(day_r, 2), c.day_stop_r, bool(reason), reason)
+
+
+def reset_for_tests() -> None:
+    _latched.clear()
