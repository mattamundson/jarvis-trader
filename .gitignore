# JARVIS TRADER — Git Ignore
# NEVER commit secrets, API keys, or sensitive data

# Environment files (SECRETS)
.env
.env.local
.env.*.local
*.env

# Claude Code local overrides (may contain machine-specific paths)
.claude/settings.local.json
CLAUDE.local.md

# OAuth / Google Cloud client JSON (never commit)
client_secret*.json
*client_secret*.json
*apps.googleusercontent.com*.json
credentials.json
token.json

# API Keys and Secrets (comprehensive pattern matching)
*.pem
*.key
*.pfx
*.p12
secret*.json
*secret*.json
*.key.txt
*oauth*.json
*token*.json
.aws/credentials
.gcp/
.gcloud/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
.virtualenv/

# Node.js / Next.js
node_modules/
node_modules.bak/
.next/
.nuxt/
out/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Data files (can be large)
data/*.parquet
data/*.csv
data/*.h5
data/*.pkl

# RL training artifacts (large; regenerate locally)
engine/data/rl_cache/
engine/data/rl_models/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker volumes (local only)
.docker/

# Trading-specific
# Never commit backtest results with personal financial data
backtest_results/personal/

# Schwab OAuth token (generated by schwab-py auth flow — never commit)
.schwab_token.json
engine/.schwab_token.json

# Backtest cache (large CSV data files — regenerate with fetch scripts)
engine/backtest/cache/

# Backtest result JSON output artifacts (regenerate by running backtest)
engine/backtest/results/*.json

# Paper trading JSONL logs (deprecated — use SQLite instead)
engine/backtest/results/*.jsonl
engine/portfolio/*.jsonl
engine/data/*.jsonl

# SQLite database files (runtime data — never commit)
*.db-wal
*.db-shm
**/.fuse_hidden*
engine/data/*.db
engine/data/*.backup_*
engine/data/backups/
engine/jarvis_trader.db
data/*.db
data/*.db-wal
data/*.db-shm

# Tooling / analysis caches (regenerate locally)
.mypy_cache/
**/.mypy_cache/
.pnpm-store/
.playwright-mcp/
.coverage
coverage.xml
htmlcov/

# Bundles / large local artifacts (do not commit)
*.zip
n-autoresearch*.zip
agent-reach*.zip

# Windows NUL artifact (accidental file)
engine/nul
