# JARVIS TRADER — Git Ignore
# NEVER commit secrets, API keys, or sensitive data

# Environment files (SECRETS)
.env
.env.local
.env.*.local
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
.virtualenv/

# Node.js / Next.js
node_modules/
.next/
.nuxt/
out/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Data files (can be large)
data/*.parquet
data/*.csv
data/*.h5
data/*.pkl

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker volumes (local only)
.docker/

# Trading-specific
# Never commit backtest results with personal financial data
backtest_results/personal/
