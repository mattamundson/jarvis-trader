{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mattamundson/jarvis-trader/engine/research/strategy_registry.schema.json",
  "title": "JARVIS Strategy Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy_id",
    "hypothesis",
    "status",
    "owner",
    "created_at",
    "instruments",
    "timeframes",
    "data_contract",
    "research_lineage",
    "backtest",
    "robustness",
    "risk_envelope",
    "promotion_gate"
  ],
  "properties": {
    "strategy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "research",
        "backtest",
        "walk_forward",
        "paper_shadow",
        "paper_candidate",
        "production_candidate",
        "approved",
        "halted",
        "rejected"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9._/-]{1,12}$"
      }
    },
    "timeframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+[mhdw]$"
      }
    },
    "data_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "feature_families",
        "freshness_sla",
        "leakage_controls"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "feature_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freshness_sla": {
          "type": "string"
        },
        "leakage_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "research_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repos",
        "notebooks",
        "docs"
      ],
      "properties": {
        "source_repos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notebooks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "backtest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "train_window",
        "test_window",
        "metrics",
        "artifact_paths"
      ],
      "properties": {
        "runner": {
          "type": "string"
        },
        "train_window": {
          "type": "string"
        },
        "test_window": {
          "type": "string"
        },
        "metrics": {
          "type": "object",
          "required": [
            "profit_factor",
            "max_drawdown_pct",
            "trade_count"
          ],
          "properties": {
            "profit_factor": {
              "type": "number"
            },
            "sharpe": {
              "type": "number"
            },
            "sortino": {
              "type": "number"
            },
            "max_drawdown_pct": {
              "type": "number"
            },
            "trade_count": {
              "type": "integer",
              "minimum": 0
            },
            "p_edge": {
              "type": "number"
            },
            "dsr": {
              "type": "number"
            }
          }
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "robustness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "walk_forward",
        "parameter_stability",
        "regime_split",
        "monte_carlo"
      ],
      "properties": {
        "walk_forward": {
          "type": "string"
        },
        "parameter_stability": {
          "type": "string"
        },
        "regime_split": {
          "type": "string"
        },
        "monte_carlo": {
          "type": "string"
        }
      }
    },
    "risk_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_position_size",
        "daily_loss_limit_pct",
        "kill_switch_dependencies",
        "paper_only_until"
      ],
      "properties": {
        "max_position_size": {
          "type": "string"
        },
        "daily_loss_limit_pct": {
          "type": "number"
        },
        "kill_switch_dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "paper_only_until": {
          "type": "string"
        }
      }
    },
    "promotion_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_verdict",
        "required_evidence",
        "human_approval_required",
        "blocking_conditions"
      ],
      "properties": {
        "current_verdict": {
          "type": "string",
          "enum": [
            "not_started",
            "blocked",
            "fail",
            "pass",
            "approved"
          ]
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "human_approval_required": {
          "type": "boolean"
        },
        "blocking_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
