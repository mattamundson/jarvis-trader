# JARVIS Morning Alpha — supplemental environment template
# Copy these values into engine/.env. This file contains no secrets.

# Master feature switch. Default-off in code.
MORNING_ALPHA_ENABLED=false

# Paper-forward observation switch. Requires MORNING_ALPHA_ENABLED=true.
# Morning Alpha v1 contains no live broker mutation/order-routing path.
MORNING_ALPHA_PAPER_OBSERVATION=false

# Alpaca market-data credentials used by the Morning Alpha provider.
MORNING_ALPHA_ALPACA_API_KEY=YOUR_ALPACA_KEY_HERE
MORNING_ALPHA_ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_HERE
MORNING_ALPHA_ALPACA_FEED=sip

# Historical research store and append-only operational journal.
MORNING_ALPHA_DATA_DIR=./data/morning_alpha
MORNING_ALPHA_POSTGRES_DSN=postgresql://jarvis:jarvis@localhost:5432/jarvis_trader
