# engine/.env.op-template
#
# 1Password env-file template for the JARVIS engine.
#
# Loaded via:
#   op run --env-file=.env.op-template -- python main.py
#
# Replaces plaintext engine/.env post-Phase 0 rotation. All values are
# op:// references resolved at runtime by the 1Password CLI against the
# "Amo Personal" vault. No plaintext secrets ever touch disk.
#
# Mappings mirror C:\Users\mattm\scripts\load-secrets.ps1 (28 entries).
# Edit there first, then regenerate this file to keep them in sync.
#
# Generated by Wave 1 agent #2 on 2026-05-05.

# --- Original 8 (top-level API keys) ---
ANTHROPIC_API_KEY=op://Amo Personal/Anthropic-API/credential
OPENAI_API_KEY=op://Amo Personal/OpenAI-API/credential
GOOGLE_API_KEY=op://Amo Personal/Google-API/credential
CURSOR_API_KEY=op://Amo Personal/Cursor-API/credential
RENDER_API_KEY=op://Amo Personal/Render-API/credential
PARADIGM_API_KEY=op://Amo Personal/Paradigm-API/credential
OPENROUTER_API_KEY=op://Amo Personal/OpenRouter-API/credential
FIRECRAWL_API_KEY=op://Amo Personal/Firecrawl-API/credential

# --- Azure AD / Microsoft 365 (Service 8 -- multi-field item) ---
AZURE_CLIENT_SECRET=op://Amo Personal/Azure-GMS-App/client_secret
AZURE_TENANT_ID=op://Amo Personal/Azure-GMS-App/tenant_id
AZURE_CLIENT_ID=op://Amo Personal/Azure-GMS-App/client_id

# --- Google AI alias (same key as GOOGLE_API_KEY) ---
GOOGLE_AI_API_KEY=op://Amo Personal/Google-API/credential

# --- Twilio (Service 12 -- multi-field) ---
TWILIO_AUTH_TOKEN=op://Amo Personal/Twilio/auth_token
TWILIO_ACCOUNT_SID=op://Amo Personal/Twilio/account_sid

# --- Telegram bot (Service 13) ---
TELEGRAM_BOT_TOKEN=op://Amo Personal/Telegram-Bot-Jarvis/credential

# --- Jarvis internal (Service 11 -- generated, not at any issuer) ---
JWT_SECRET_KEY=op://Amo Personal/Jarvis-Internal-Keys/jwt_secret_key
AUDIT_HMAC_KEY=op://Amo Personal/Jarvis-Internal-Keys/audit_hmac_key

# --- Paradigm bearer (Service 9 -- paired with PARADIGM_API_KEY above) ---
PARADIGM_BEARER_TOKEN=op://Amo Personal/Paradigm-ERP/bearer_token

# --- Supermemory (Cursor IDE plugin) ---
SUPERMEMORY_CC_API_KEY=op://Amo Personal/Supermemory-API/credential
