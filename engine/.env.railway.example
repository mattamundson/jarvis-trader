# ─────────────────────────────────────────────────────────────────────────────
# JARVIS TRADER ENGINE — Railway Environment Variables
#
# Copy these into Railway → your engine service → Variables tab.
# Never commit actual secret values — this file is a reference template only.
#
# Required = engine won't start or will run degraded without it
# Optional = feature is disabled gracefully if missing
# ─────────────────────────────────────────────────────────────────────────────

# ── API Security (Required) ───────────────────────────────────────────────────
# Protects all engine endpoints via X-API-Key header
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-secret-api-key-here

# ── CORS (Required for Vercel dashboard) ─────────────────────────────────────
# Comma-separated, no trailing slashes
CORS_ALLOWED_ORIGINS=https://jarvis-trader-plum.vercel.app

# ── IB Gateway (Required for execution) ──────────────────────────────────────
# Railway private network hostname for your IB Gateway service
# Format: <service-name>.railway.internal
# Find your service name in Railway dashboard → your IB Gateway service
IBKR_HOST=your-ibgateway-service-name.railway.internal
IBKR_PORT=4002
IBKR_PAPER_MODE=true
IBKR_CLIENT_ID=1

# ── Trading Mode (Required) ───────────────────────────────────────────────────
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
REQUIRE_HUMAN_APPROVAL=true

# ── LLM — Anthropic (Required for pipeline analysis) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Database (Required) ───────────────────────────────────────────────────────
# Railway PostgreSQL: add a Postgres service, Railway auto-injects DATABASE_URL
# Map it to POSTGRES_URL:
POSTGRES_URL=${{Postgres.DATABASE_URL}}

# Redis: add a Redis service, Railway auto-injects REDIS_URL
REDIS_URL=${{Redis.REDIS_URL}}

# SQLite (local fallback — Railway ephemeral disk, data lost on redeploy)
# For persistence, use PostgreSQL above
SQLITE_DB_PATH=data/jarvis_trader.db

# ── Market Data (Optional — features degrade gracefully without these) ────────
POLYGON_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=

# ── Notifications (Optional) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1...
WHATSAPP_TO=whatsapp:+1...

# ── Dashboard URL (for approval links in notifications) ───────────────────────
DASHBOARD_PUBLIC_URL=https://jarvis-trader-plum.vercel.app

# ── Engine Behavior ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
WATCHLIST_SCAN_ENABLED=true
PORT=8010
