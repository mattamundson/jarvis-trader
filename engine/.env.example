# JARVIS TRADER — Environment Variables
# Copy to .env and fill in your keys. Never commit .env to git.

# ── Interactive Brokers ───────────────────────────────────────────────────
# No API keys needed — connects to IB Gateway running on localhost
# 4002 = paper trading (default, safe)
# 4001 = live trading (only change when ready)
IBKR_PORT=4002
IBKR_PAPER_MODE=True

# ── Charles Schwab ────────────────────────────────────────────────────────
# Register app at: https://developer.schwab.com/
# Refresh token expires every 7 days — you'll need to re-auth weekly
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1

# ── Market Data ───────────────────────────────────────────────────────────
# Polygon.io — https://polygon.io/ (Starter plan $29/mo recommended)
POLYGON_API_KEY=your_polygon_key_here

# Finnhub — https://finnhub.io/ (free tier available)
FINNHUB_API_KEY=your_finnhub_key_here

# Alpaca (optional — for paper trading data only, free)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=True

# ── LLM (Anthropic) ───────────────────────────────────────────────────────
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Databases (Docker defaults) ───────────────────────────────────────────
POSTGRES_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis_trader
REDIS_URL=redis://localhost:6379
QUESTDB_HOST=localhost
QUESTDB_PORT=9000

# ── Notifications ─────────────────────────────────────────────────────────
# Create a Telegram bot at: https://t.me/botfather
# Get your chat ID at: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Safety Controls (Start conservative) ─────────────────────────────────
# NEVER change these until you've paper traded for 3+ months
LIVE_TRADING_ENABLED=False
REQUIRE_HUMAN_APPROVAL=True
