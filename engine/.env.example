# JARVIS TRADER — Environment Variables Template
# Copy to engine/.env and fill in your keys. NEVER commit .env to git.
#
# Sections:
#   TRADING MODE        — Paper vs. Live, autonomy settings
#   IB GATEWAY          — Interactive Brokers connection (paper trading)
#   SAFETY & RISK       — Kill switches, position limits, halt conditions
#   INSTRUMENTS         — Symbols to trade
#   MARKET DATA APIs    — Third-party quote/fundamental data
#   LLM & AGENTS        — Anthropic Claude for trading pipeline
#   DATABASES           — PostgreSQL, Redis, QuestDB (Docker)
#   NOTIFICATIONS       — WhatsApp, Telegram alerts
#   API SECURITY        — Authentication and security

# ────────────────────────────────────────────────────────────────────────────
# SECTION 1: TRADING MODE
# ────────────────────────────────────────────────────────────────────────────

# Paper Trading Mode (CRITICAL)
# True = orders logged but NOT sent to broker (safe for testing)
# False = orders sent to live broker (requires LIVE_TRADING_ENABLED=True)
PAPER_TRADING=True

# Paper Trading Broker Selection
# Options: IB_GATEWAY, SCHWAB (Schwab not yet implemented for paper)
PAPER_TRADING_BROKER=IB_GATEWAY

# Live Trading Flag (SAFETY LOCK)
# Must be False during paper trading phase.
# Only set to True with Tier 3 approval after successful 30-day paper test.
# [CRITICAL: Hardcoded safety check — setting this True without proper procedure blocks startup]
LIVE_TRADING_ENABLED=False

# Autonomy Level
# True = requires human approval for every trade (default, safe)
# False = AI agents can submit trades autonomously (requires approval step)
# [CRITICAL: Set to False only after successful 30-day paper validation]
REQUIRE_HUMAN_APPROVAL=True

# Initial Account Capital (for position sizing calculations)
# Paper trading starting allocation. Default $10,000.
INITIAL_CAPITAL=10000.0

# ────────────────────────────────────────────────────────────────────────────
# SECTION 2: INTERACTIVE BROKERS (IB GATEWAY) — PAPER TRADING
# ────────────────────────────────────────────────────────────────────────────

# IB Gateway Host and Port
# Port 4002 = IB Gateway Paper Trading (default)
# Port 4001 = IB Gateway Live Trading (permanently blocked during paper phase)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002

# Client ID for IB Gateway Connection
# config.py reads only IBKR_CLIENT_ID (single connection)
# [REQUIRED for order routing and market data]
IBKR_CLIENT_ID=2

# IB Gateway Paper Mode
# True = paper trading (safe, no real money)
# False = live trading (requires real capital, risky)
IBKR_PAPER_MODE=True

# Interactive Brokers Account ID
# Format: e.g., DU123456 (find in Account Settings → Account Information)
# [REQUIRED for order routing — used in trade confirmations]
IB_ACCOUNT_ID=YOUR_IBKR_ACCOUNT_ID

# ────────────────────────────────────────────────────────────────────────────
# SECTION 3: SAFETY & RISK PARAMETERS
# ────────────────────────────────────────────────────────────────────────────

# Daily Loss Halt Threshold (Kill Switch Trigger)
# If daily P&L drops below this %, kill switch auto-activates
# -0.02 = -2% (hardcoded safety limit)
MAX_DAILY_LOSS_PCT=0.02

# Maximum Drawdown Threshold (Kill Switch Trigger)
# If peak-to-trough drawdown exceeds this %, kill switch auto-activates
# -0.10 = -10% (hardcoded safety limit)
MAX_DRAWDOWN_PCT=0.10

# Maximum Position Size (% of portfolio)
# Single position cannot exceed this % of account balance
# 0.05 = 5% max per position (hardcoded safety limit)
MAX_POSITION_SIZE_PCT=0.05

# Maximum Contracts Per Instrument
# Won't open more than N contracts on any single symbol
# 2 = 2 micro contracts max (hardcoded safety limit)
MAX_CONTRACTS_PER_INSTRUMENT=2

# Maximum Overnight Contracts
# Can hold at most N contracts overnight (gap risk protection)
# 1 = 1 contract max overnight (hardcoded safety limit)
MAX_OVERNIGHT_CONTRACTS=1

# Maximum Single Order Value
# No individual order can exceed this dollar amount
# 5000.0 = $5,000 per order (hardcoded safety limit)
MAX_SINGLE_ORDER_VALUE=5000.0

# Maximum Margin Utilization
# Won't use more than this % of available margin
# 0.40 = 40% margin max (hardcoded safety limit)
MAX_MARGIN_UTILIZATION=0.40

# Price Collar Violation Threshold
# Orders > this % away from NBBO are rejected (slippage protection)
# 0.05 = 5% collar (hardcoded safety limit)
PRICE_COLLAR_PCT=0.05

# Maximum Order Rate (Throttle)
# Won't submit more than N orders per minute (prevent runaway)
# 10 = 10 orders/minute max (hardcoded safety limit)
MAX_ORDERS_PER_MINUTE=10

# Correlated Exposure Cap
# Total exposure to correlated assets (same sector/asset class) can't exceed this %
# 0.20 = 20% max correlated exposure (hardcoded safety limit)
MAX_CORRELATED_EXPOSURE_PCT=0.20

# Consecutive Loss Protection
# Position size reduced after N consecutive losses (risk reduction)
CONSECUTIVE_LOSS_HALF_SIZE=3        # After 3 losses: 0.5x position size
CONSECUTIVE_LOSS_QUARTER_SIZE=5     # After 5 losses: 0.25x position size
CONSECUTIVE_LOSS_HALT=7              # After 7 losses: halt trading entirely
CONSECUTIVE_LOSS_HALT_HOURS=24       # Halt duration (hours before retry)

# ────────────────────────────────────────────────────────────────────────────
# SECTION 4: INSTRUMENTS TO TRADE
# ────────────────────────────────────────────────────────────────────────────

# Futures Watchlist (comma-separated symbols)
# Only MES and MNQ are validated for paper trading
# MES = Micro S&P 500 (approved, WFE=0.09)
# MNQ = Micro NASDAQ-100 (approved, WFE=0.57)
# MCL = Crude Oil (approved, WFE=0.82)
FUTURES_WATCHLIST=MES,MNQ,MCL

# Options Watchlist (comma-separated symbols)
# Stocks on which to trade options (if options module enabled)
OPTIONS_WATCHLIST=SPY,QQQ,AAPL,TSLA

# Crypto Watchlist (comma-separated symbols, if crypto module enabled)
# CRYPTO_WATCHLIST=BTC,ETH

# ────────────────────────────────────────────────────────────────────────────
# SECTION 5: MARKET DATA APIs
# ────────────────────────────────────────────────────────────────────────────

# Polygon.io API Key (for real-time market data, options chains, fundamental data)
# Get key at: https://polygon.io/dashboard/api-keys
# Plan: Starter ($29/month) recommended for paper trading
# Used by: DataAggregatorAgent, OptionsChainAnalyzer
# Note: Free tier has rate limits — price caching (60s TTL) is enabled to handle 429 errors
POLYGON_API_KEY=pk_live_YOUR_POLYGON_KEY_HERE

# FRED API Key (for economic indicators, yield curve, VIX data from Federal Reserve)
# Get key at: https://fred.stlouisfed.org/docs/api/
# Free tier available (120 requests/minute)
# Used by: FundamentalAnalyzer, regime filter (VIX, yield spreads)
# If not set, VIX data falls back to yfinance (delayed, less reliable)
FRED_API_KEY=YOUR_FRED_API_KEY_HERE

# Finnhub API Key (for news sentiment, earnings, economic calendar)
# Get key at: https://finnhub.io/dashboard
# Free tier available (60 calls/minute)
# Used by: NewsAnalystAgent, FundamentalAnalyzer
FINNHUB_API_KEY=YOUR_FINNHUB_KEY_HERE

# Alpaca API (for paper trading data, free tier)
# Get key at: https://app.alpaca.markets/signup
# Paper trading accounts get free real-time quotes
# Used as fallback if Polygon fails
ALPACA_API_KEY=YOUR_ALPACA_KEY_HERE
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_HERE
ALPACA_PAPER=True

# StockTwits Token (for retail sentiment, optional)
# Get at: https://api.stocktwits.com/developers/
# Used by: SocialAnalystAgent
STOCKTWITS_TOKEN=YOUR_STOCKTWITS_TOKEN

# ────────────────────────────────────────────────────────────────────────────
# SECTION 6: LLM & TRADING AGENTS (Anthropic)
# ────────────────────────────────────────────────────────────────────────────

# Anthropic API Key (REQUIRED for agent pipeline)
# Get at: https://console.anthropic.com/account/keys
# Used by: TechnicalAnalyst, NewsAnalyst, TraderAgent, RiskManagerAgent, FundManagerAgent
# [REQUIRED — agent pipeline won't start without this]
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE

# LLM Provider (default: anthropic)
# Changing this requires corresponding code updates
LLM_PROVIDER=anthropic

# Model Selection (optional overrides — uses config.py defaults if not set)
# Default models:
#   ANALYST_MODEL = claude-sonnet-4-6 (balances speed + quality for analysis)
#   TRADER_MODEL = claude-opus-4-6 (best quality for final trading decisions)
#   FAST_MODEL = claude-haiku-4-5-20251001 (fast, for routing & classification)
# Uncomment to override:
# ANALYST_MODEL=claude-sonnet-4-6
# TRADER_MODEL=claude-opus-4-6
# FAST_MODEL=claude-haiku-4-5-20251001

# ────────────────────────────────────────────────────────────────────────────
# SECTION 7: DATABASES (Docker Compose Stack)
# ────────────────────────────────────────────────────────────────────────────

# PostgreSQL Connection
# Stores: trades, orders, portfolio state, agent decisions, audit trail
# Default: jarvis/jarvis user, jarvis_trader database
# URL format: postgresql://[user]:[password]@[host]:[port]/[database]
POSTGRES_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis_trader

# Redis Connection
# Stores: market data cache, signal bus, feature store, session state
# URL format: redis://[host]:[port] (no auth in Docker default)
REDIS_URL=redis://localhost:6379

# QuestDB Connection (Time-Series Database)
# Stores: OHLCV candles, tick data, technical indicators
# HTTP API: http://localhost:9000
QUESTDB_HOST=localhost
QUESTDB_PORT=9000

# ────────────────────────────────────────────────────────────────────────────
# SECTION 8: NOTIFICATIONS (Optional)
# ────────────────────────────────────────────────────────────────────────────

# WhatsApp Alerts (via Twilio) — OPTIONAL
# Setup:
#   1. Sign up at https://www.twilio.com/
#   2. Enable WhatsApp Sandbox in Twilio console
#   3. Text "join <sandbox-word>" to +1 415 523 8886
# Account SID and Auth Token found in Twilio dashboard
TWILIO_ACCOUNT_SID=AC_YOUR_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN_HERE
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+1XXXXXXXXXX

# Telegram Alerts (alternative to WhatsApp) — OPTIONAL
# Setup:
#   1. Create bot at https://t.me/botfather
#   2. Get chat ID at https://t.me/userinfobot
# If both WhatsApp and Telegram configured, both receive alerts
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# ────────────────────────────────────────────────────────────────────────────
# SECTION 9: API SECURITY
# ────────────────────────────────────────────────────────────────────────────

# FastAPI X-API-Key Header Authentication
# Change to a strong random key before exposing engine externally
# Used to protect all API endpoints: /v1/*, /admin/*, /debug/*
# [REQUIRED to protect API]
API_KEY=jarvis-dev-key-change-me

# Logging Level (for debug, info, warning, error, critical)
# INFO = normal operation, warnings and errors
# DEBUG = verbose, includes all function calls and data flows
# WARNING = only warnings and errors (production mode)
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────────────────────────────
# SECTION 10: ADVANCED (Usually don't need to change)
# ────────────────────────────────────────────────────────────────────────────

# Schwab Connector (for live trading phase only, not paper)
# [CRITICAL: Must remain False during paper trading]
SCHWAB_READY=False

# TradingView Webhook Secret (optional, for external signal validation)
# If set, all TradingView webhooks must include matching "secret" field
# Leave blank to disable secret validation
TRADINGVIEW_WEBHOOK_SECRET=your_secret_here

# Charles Schwab (for live trading phase only — not used in paper mode)
# Refresh token expires every 7 days (manual re-auth required)
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1
