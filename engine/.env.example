# JARVIS TRADER — Environment Variables Template
# Copy to engine/.env and fill in your keys. NEVER commit .env to git.
#
# Sections:
#   TRADING MODE        — Paper vs. Live, autonomy settings
#   IB GATEWAY          — Interactive Brokers connection (paper trading)
#   SAFETY & RISK       — Kill switches, position limits, halt conditions
#   INSTRUMENTS         — Symbols to trade
#   MARKET DATA APIs    — Third-party quote/fundamental data
#   LLM & AGENTS        — Anthropic Claude for trading pipeline
#   DATABASES           — PostgreSQL, Redis, QuestDB (Docker)
#   NOTIFICATIONS       — WhatsApp, Telegram alerts
#   API SECURITY        — Authentication and security

# TRADING MODE
# Paper mode (True) = orders logged, not sent to broker. Live mode (False) = requires LIVE_TRADING_ENABLED=True
PAPER_TRADING=True
PAPER_TRADING_BROKER=IB_GATEWAY
LIVE_TRADING_ENABLED=False
ALLOW_PAPER_SIMULATED_ORDERS=False
REQUIRE_HUMAN_APPROVAL=True
INITIAL_CAPITAL=10000.0
# Base URL for links in WhatsApp / Discord when a trade is queued for human approval
DASHBOARD_PUBLIC_URL=http://localhost:3010

# IB GATEWAY (Paper mode: port 4002, Live: port 4001 blocked)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=2
IBKR_PAPER_MODE=True
IB_ACCOUNT_ID=YOUR_IBKR_ACCOUNT_ID
# Cap startup TCP handshake so engine lifespan doesn't block 30-120s when
# IB Gateway isn't running. Bump to 10-15 if Gateway boot races engine boot.
IBKR_CONNECT_TIMEOUT_SECONDS=5

# IB DATA-LEG AUTO-RECONNECT WATCHDOG
# Self-heals the market-data IB connection if it drops mid-session (daily Gateway
# restart, network blip). Read at use-site (not config.py) to stay outside the
# safety-invariant gate.
IBKR_DATA_WATCHDOG_ENABLED=1          # 0/false/no/off disables the watchdog
IBKR_DATA_WATCHDOG_INTERVAL=30        # poll seconds (floored at 5)
IBKR_DATA_WATCHDOG_MAX_BACKOFF=300    # cap on reconnect-spacing after repeated failures
IBKR_DATA_STALE_SECONDS=180           # connected-but-no-fresh-data → reconnect (0 disables)
# Daily IB Gateway restart window (local "HH:MM-HH:MM"; blank disables). Inside it
# the watchdog suppresses alerts and tightens reconnect spacing — the Gateway is
# expected down and returns within minutes. Supports windows that wrap midnight.
IBKR_GATEWAY_RESTART_WINDOW=           # e.g. 23:50-00:10

# SAFETY & RISK PARAMETERS (All hardcoded limits — see safety.md for details)
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
MAX_POSITION_SIZE_PCT=0.05
MAX_CONTRACTS_PER_INSTRUMENT=2
MAX_OVERNIGHT_CONTRACTS=1
MAX_SINGLE_ORDER_VALUE=5000.0
MAX_MARGIN_UTILIZATION=0.40
PRICE_COLLAR_PCT=0.05
MAX_ORDERS_PER_MINUTE=10
MAX_CORRELATED_EXPOSURE_PCT=0.20
# Volatility-targeting sizing overlay (DEFAULT OFF — leave false until owner-enabled).
# When true, scales contracts by clip(target_vol/realized_vol, 0, max_leverage) as a
# final risk overlay. OOS-validated on MGC trend (Sharpe +0.69, MaxDD -59%).
VOL_TARGET_ENABLED=false
VOL_TARGET_MAX_LEVERAGE=3.0
# Per-symbol target annualized realized vol (%), JSON. MGC=13.3 from the WFO study.
VOL_TARGET_PER_SYMBOL={"MGC": 13.3}
CONSECUTIVE_LOSS_HALF_SIZE=3
CONSECUTIVE_LOSS_QUARTER_SIZE=5
CONSECUTIVE_LOSS_HALT=7
CONSECUTIVE_LOSS_HALT_HOURS=24

# INSTRUMENTS TO TRADE (comma-separated)
# Futures: MES (S&P 500 micro), MNQ (NASDAQ micro), MCL (crude oil), MGC (gold micro)
# NOTE: MES and MGC are paper-walk-forward-only per their WFE verdicts:
#   MES=0.09 REJECTED 2026-04-02 — Tier 3 paper walk-forward authorized 2026-04-09
#   MGC=0.14 HALTED — pipeline outputs computed for validation but NEVER trigger paper orders
# Their pipeline outputs feed the dashboard and briefing system for validation feedback.
# Flip to active: WFE >= 0.6, gate v2 PASS, Tier 3 authorization, then remove from
# VALIDATION_ONLY_INSTRUMENTS in engine/agents/pipeline.py.
FUTURES_WATCHLIST=MES,MNQ,MCL,MGC
# Options: underlying symbols for options trading (if module enabled)
OPTIONS_WATCHLIST=SPY,QQQ,AAPL,TSLA

# RV filter thresholds — per-instrument realized-volatility gate (optional).
# When set, the live signal pipeline suppresses entries when 20-bar annualized
# realized volatility (1h bars) falls below this threshold.
# Implemented in backtest/signals.py via env var {SYMBOL}_MIN_RV_ANNUALIZED (default "0.0").
# Leave commented out (disabled) until 60+ live trades confirm calibration.
# Validated thresholds: MES=9.0% (ALT PASS 2026-05-24), MGC=9.0% (CORE PASS 2026-05-24)
# MES_MIN_RV_ANNUALIZED=9.0
# MGC_MIN_RV_ANNUALIZED=9.0

# MARKET DATA APIs
POLYGON_API_KEY=pk_live_YOUR_POLYGON_KEY_HERE
FRED_API_KEY=YOUR_FRED_API_KEY_HERE
FINNHUB_API_KEY=YOUR_FINNHUB_KEY_HERE
ALPACA_API_KEY=YOUR_ALPACA_KEY_HERE
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_HERE
ALPACA_PAPER=True

# SOCIAL SENTIMENT APIs
# StockTwits OAuth token (optional — enriches SocialAnalyst with bullish/bearish message counts)
STOCKTWITS_TOKEN=
# Reddit PRAW credentials (optional — enables raw fetch from futures-specific subreddits
# like r/energy, r/oilandgas, r/FuturesTrading for instrument-accurate sentiment).
# Acquire at https://www.reddit.com/prefs/apps → create a "script" type app.
# Without these, SocialAnalyst falls back to ApeWisdom aggregator only.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=jarvis-trader/1.0 (social_analyst; read-only)

# DISCORD DATA IMPORT (DiscordChatExporter — for automated channel ingestion)
# Get your token: Open Discord in browser → F12 → Network tab → any request → Authorization header
# Or from Discord desktop: Ctrl+Shift+I → Console → paste:
#   webpackChunkdiscord_app.push([[Math.random()],{},e=>{m=[];for(let c in e.c)m.push(e.c[c])}]);m.filter(m=>m?.exports?.default?.getToken!==void 0).map(m=>m.exports.default.getToken())[0]
# WARNING: Treat this like a password. Never commit .env.
# Canonical store: op://Amo Personal/Discord-DCE/credential (mapped in ~/scripts/load-secrets.ps1).
# Discord revokes this on every password change; rotation runbook: scripts/REFRESH_DISCORD_TOKEN.md.
# This .env copy is the runtime source for the scheduled Jarvis-DiscordAutoImport task (op has no
# unattended session in Task Scheduler), so keep it in sync with the 1Password item after rotating.
DISCORD_TOKEN=your_discord_user_token_here

# PERSONAL DISCORD MCP (live REST access to a single channel via personal_mcp_server.py)
# Create a bot at https://discord.com/developers/applications → enable MESSAGE CONTENT INTENT
# → invite to your guild with View Channels + Read Message History (+ Send Messages for posting)
DISCORD_PERSONAL_BOT_TOKEN=your_personal_discord_bot_token_here
DISCORD_PERSONAL_CHANNEL_ID=
DISCORD_PERSONAL_GUILD_ID=

# Discord user ID (Matt's account) — ONLY this user can trigger approval reactions
# Find your ID: Discord → Settings → Advanced → enable Developer Mode → right-click your avatar → Copy User ID
# The reaction watcher is DEFAULT-OFF; both this and DISCORD_PERSONAL_BOT_TOKEN must be set to enable it.
DISCORD_PERSONAL_USER_ID=

# LLM & TRADING AGENTS (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE
LLM_PROVIDER=anthropic
ANALYST_MODEL=claude-sonnet-4-6
TRADER_MODEL=claude-opus-4-7
FAST_MODEL=claude-haiku-4-5-20251001
# Hard wall-clock ceiling (seconds) for ANY single LLM provider call. Defensive
# backstop above each provider's own httpx/SDK read timeout: a stalled
# connection that slips past the per-read timeout is cancelled here so no single
# call can freeze the async pipeline (2026-06-04: one Gemini call hung ~3.9h and
# froze the engine ~13h). Default 120. Invalid / <=0 falls back to 120.
LLM_CALL_HARD_TIMEOUT_SECONDS=120

# DATABASES (Docker Compose stack for multi-instance deployments)
POSTGRES_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis_trader
REDIS_URL=redis://localhost:6379
QUESTDB_HOST=localhost
QUESTDB_PORT=9000

# NOTIFICATIONS (Optional — WhatsApp via Twilio or Telegram)
TWILIO_ACCOUNT_SID=AC_YOUR_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN_HERE
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+1XXXXXXXXXX
# Optional: Discord incoming webhook for pending-approval pings (same channel you monitor)
# JARVIS_DISCORD_APPROVAL_WEBHOOK=https://discord.com/api/webhooks/...

# API SECURITY & LOGGING
# Use a long random value; must match NEXT_PUBLIC_ENGINE_API_KEY in dashboard/.env.local.
# Rotate both at once: python scripts/rotate_dev_api_key.py (see docs/setup-guides/DEV_API_KEY_ROTATION.md)
API_KEY=jarvis-dev-key-change-me
LOG_LEVEL=INFO

# ---- Entry price sanity check (default ON, opt-out) --------------------
# Rejects order submissions where |entry_price - market_price| / ATR > N.
# Catches corrupted-price bugs at the order surface.
# Incident: 2026-05-09 phantom-trade — stop_loss copied into entry_price,
#   entries inserted at 7398.5481 when market was ~7385 (delta/ATR ≈ 1.35).
ENABLE_ENTRY_PRICE_SANITY=1
ENTRY_PRICE_SANITY_MAX_ATR_DELTA=1.0

# ---- Write-time bar-quality gate (default ON shadow, enforce opt-in) -----
# Screens OHLCV ticks before they persist to market_data_bars, blocking the
# contamination classes from the 2026-06-11 edge re-assessment (impossible
# bars, range explosions, lone neighbour jumps, smoke_test source leakage).
# Shadow (default): screens + logs verdicts, writes everything. Flip ENFORCE
# to 1 to DROP rejected rows. Watch jarvis_trader.bar_quality logs in shadow
# for a cycle before enforcing. Thresholds sit far above any real futures move.
BAR_QUALITY_GATE_ENABLED=1
BAR_QUALITY_GATE_ENFORCE=0
# BAR_QUALITY_MAX_RANGE_FRAC=0.50
# BAR_QUALITY_MAX_JUMP_FRAC=0.50

# ---- Beta-harvest gate variant (Tier-3, APPROVED 2026-06-25) -------------
# Routes a strategy tagged strategy_class="beta_harvest" (e.g. turn-of-month)
# through gate_v2_beta_harvest_verdict: the p_edge core floor drops 0.95 -> 0.60
# AND a chronological H1/H2 stationarity test is required. Approved policy; this
# flag is the runtime activation (shadow-default 0). It only changes the gate
# VERDICT for tagged strategies -- it promotes NOTHING (evaluate_promotion still
# requires robust_edge + paper_shadow + live_system_stable). See
# engine/docs/BETA_HARVEST_GATE_PROPOSAL.md. Flip to 1 to activate.
BETA_HARVEST_GATE_ENFORCE=0

# ---- IB market scanner (default off, read-only) -------------------------
# When enabled, /ib-scanner/* routes return live scanner data from IB Gateway.
# No orders. Requires IB Gateway connected on paper port 4002.
# Rerun every 60s for fresh data — IB caches scanner results server-side for up to 30s.
ENABLE_IB_SCANNER=0

# FEATURE FLAGS (Experimental features — enable with caution)
ENABLE_TILT_DETECTION=True
ENABLE_KAIROS=False
ENABLE_SPECULATION=False
# Risk Attribution Engine — read-only P&L decomposition across pipeline analysts
# Routes: GET /attribution/daily and GET /attribution/window (always registered)
# This flag is reserved for future scheduled vault writeback (vault cron job check).
ENABLE_RISK_ATTRIBUTION=0

# ORCHESTRATOR & PERFORMANCE
DAILY_TARGET=500.0
DATA_DIR=./data

# DASHBOARD (Next.js frontend) — duplicate for convenience; canonical file is dashboard/.env.local
NEXT_PUBLIC_ENGINE_API_KEY=jarvis-dev-key-change-me

# TELEGRAM ALERTS (Alternative to WhatsApp)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# SHARED MESSAGING GATEWAY (single ingress for OpenClaw + Hermes)
MESSAGING_DEFAULT_AGENT=openclaw
MESSAGING_MAX_HISTORY_MESSAGES=10
MESSAGING_ALLOWED_TELEGRAM_CHAT_IDS=
MESSAGING_ALLOWED_WHATSAPP_NUMBERS=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENCLAW_LOCAL_MODEL=ollama/qwen2.5:7b
OPENCLAW_AGENT_COMMAND_TEMPLATE=openclaw agent --agent main --message {message} --json
OPENCLAW_STATUS_COMMAND=openclaw gateway status
HERMES_LOCAL_MODEL=hermes3
HERMES_CLOUD_BASE_URL=
HERMES_CLOUD_MODEL=
HERMES_CLOUD_API_KEY=
# Schwab / ThinkorSwim (Charles Schwab Developer API)
# Get credentials at: https://developer.schwab.com
# 1. Create a new app — set callback URL to https://127.0.0.1
# 2. Copy App Key and App Secret below
# 3. Set SCHWAB_READY=true when credentials are configured
# 4. Run POST /schwab/connect to trigger OAuth browser flow (one-time)
# NOTE: Schwab supports equities + options only. Futures route via IBKR.
SCHWAB_APP_KEY=your_schwab_developer_app_key_here
SCHWAB_APP_SECRET=your_schwab_developer_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_READY=false

# SAFETY: Commit .env.example to git (no secrets). NEVER commit .env (real API keys).
# Jarvis quick-analysis / Gemini contract
# Local dev can use Application Default Credentials from `gcloud auth application-default login`.
# Production should use a non-interactive Google credential path available to the engine host.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
JARVIS_GEMINI_MODEL=gemini-2.5-flash

# ---- Decision-tier primary model ----------------------------------------
# Which model serves TRADE-DECISION agents (trader, risk_manager,
# fund_manager, debate/researchers) as PRIMARY. Enrichment agents
# (news/social/technical/fundamental) are always on gemini-2.5-flash and are
# unaffected by this setting.
#
# Unset (default) => Anthropic primary, historical behavior.
# gemini-2.5-pro   => Gemini serves decisions directly; Anthropic/OpenAI stay
#                     wired behind it as fallbacks. ~2.4x cheaper than Sonnet
#                     ($1.25/$10 vs $3/$15 per MTok), decision-grade reasoning,
#                     1M context, and no doomed Anthropic call per decision.
#
# Only gemini-* values route today; anything else logs a warning and is inert
# (JARVIS_LLM_PROVIDER below only ever distinguished ollama from everything
# else, so setting it to a provider name looked configured while changing
# nothing — this var refuses to repeat that failure).
JARVIS_DECISION_PRIMARY=gemini-2.5-pro
#
# ---- LLM failover legs (redundancy) -------------------------------------
# The decision pipeline can run on a primary plus three fallbacks.
# /health.llm_providers reports which leg is serving + a single_leg_warning
# when only one usable leg remains. Order on credit-exhaustion:
#   primary -> Vertex (if armed) -> Gemini -> OpenAI (last resort).
# With JARVIS_DECISION_PRIMARY=gemini-2.5-pro the decision tier starts on
# Gemini and falls back to Anthropic, then OpenAI.
#
# Gemini fallback (default ON when a key is present):
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY_HERE
JARVIS_LLM_GOOGLE_FALLBACK=1
GEMINI_REASONING_EFFORT=none          # disable 2.5 thinking so JSON isn't truncated
#
# Claude-on-Vertex failover (same model family, GCP-billed so unaffected by an
# Anthropic credit outage). Arm by setting the flag to 1 AFTER enabling Claude
# in GCP Marketplace and configuring ADC (gcloud auth application-default login
# or a service-account key). Silently self-disables if the Vertex client can't
# be built, so it is safe to leave wired.
JARVIS_LLM_VERTEX_FAILOVER=0
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
ANTHROPIC_VERTEX_REGION=us-east5
#
# OpenAI last-resort fallback (default ON when a key is present):
OPENAI_API_KEY=
JARVIS_LLM_OPENAI_FALLBACK=1

# ---- Bracket orders (default ON for approved paper trades) --------------
# When 1, approved trades submit with attached stop+target orders so IB holds
# an atomic STP + LMT bracket at the broker — broker-side risk management
# instead of relying solely on the safety-layer's engine-side monitoring.
# Set to 0 to revert to single market-order behavior (legacy path).
# Stop and target prices come from the pipeline verdict's existing fields
# (stop_price / stop_loss and target_1 / target_price / take_profit).
# Flag is read fresh on every approval so no engine restart is required.
# See engine/brokers/bracket_orders.py and docs/runbooks/IB_CONNECTOR_OVERVIEW.md.
ENABLE_BRACKET_ORDERS=1

# ---- QuestDB time-series shadow (default off) ---------------------------
# When enabled, Discord ingest dual-writes to QuestDB at QUESTDB_HOST:QUESTDB_PORT.
# Reads still come from SQLite. See docs/runbooks/QUESTDB_MIGRATION_RUNBOOK.md.
ENABLE_QUESTDB_DUAL_WRITE=0

# ---- QuestDB reconciliation (default off) -------------------------------
# Read-only daily check that SQLite and QuestDB row counts match. Companion
# to ENABLE_QUESTDB_DUAL_WRITE. Heal must be explicitly enabled separately.
# Run: python scripts/reconcile_questdb.py
# Thresholds: ok=<=0.1%, divergent=0.1-5%, critical=>5%
# Snapshots: engine/data/reconcile_snapshots/<YYYY-MM-DD>.json
# Vault:     master-jarvis/second-brain/raw/_session-reconcile/reconcile-<date>.md
ENABLE_QUESTDB_RECONCILE=0
ENABLE_QUESTDB_RECONCILE_HEAL=0

# ---- Parallel paper testing (default off) -----------------------------------
# When enabled, dual-emits paper trades to account A (prod config) and B (challenger).
# Challenger overrides in engine/config-challenger.yaml. See docs/runbooks/PARALLEL_PAPER_TESTING_RUNBOOK.md.
ENABLE_PARALLEL_PAPER=0

# ---- Experimental analysts (default off) -----------------------------------
# Kronos foundation model (shiyu-coder/Kronos) — 7th analyst stub.
# Stub returns neutral verdict; set to 1 once a real HF Inference call is wired.
ENABLE_KRONOS=0
# QuantAgent Research Agent stub — autonomous strategy hypothesis generator.
# Stub returns a hardcoded mean-reversion hypothesis; set to 1 once a real LLM
# call + strategy_tuner consumer wiring lands.
ENABLE_RESEARCH_AGENT=0
# Options analyst stage 6 — default off. Reads engine/markets/options/ for skew/term/Greeks signals.
ENABLE_OPTIONS_ANALYST=0

# ---- RL strategy discovery (training-time only, default off) -------------
# Enables the PPO training loop in engine/strategies/rl_train.py.  Output
# policies are converted to StrategyHypothesis objects and fed to gate v2
# alongside ResearchAgent output.  This is a TRAINING-TIME tool only — it
# does not route live orders and does not touch engine/risk/.
#
# Prerequisites before setting to 1:
#   pip install stable-baselines3           (inside engine/.venv)
#   pip install gymnasium                   (usually pulled in by SB3)
# GPU is NOT required but training is 10-20x slower on CPU.
# Smoke-test first: python scripts/run_rl_strategy_discovery.py --quick-smoke
#
# See docs/runbooks/RL_STRATEGY_DISCOVERY_RUNBOOK.md for the full procedure.
ENABLE_RL_STRATEGY_DISCOVERY=0

# ---- Predictive maintenance (default off) -----------------------------------
# Monitors engine memory growth, IB reconnects, LLM latency, and pm2 restart
# count. Scores 0.0 (healthy) to 1.0 (imminent failure) across four signals.
# See docs/runbooks/PREDICTIVE_MAINTENANCE_RUNBOOK.md for the rollout sequence.
ENABLE_PREDICTIVE_MAINTENANCE=0
# If 1 AND ENABLE_PREDICTIVE_MAINTENANCE=1, monitor triggers pm2 restart preemptively.
# If 0, monitor only logs WARNING + optional webhook alert. Default: alert only.
PREDICTIVE_MAINTENANCE_ALLOW_RESTART=0
# Optional webhook for degradation alerts (Discord incoming webhook or Telegram bot).
# Leave blank to suppress webhook delivery.
PREDICTIVE_MAINTENANCE_WEBHOOK_URL=

# ---- Gate v2 calibrator (default off, read-only) ---------------------------
# Bayesian posterior on the right thresholds given accumulated paper data.
# Outputs recommendations only; does NOT modify GATE_V2_* values.
# Runs via: engine/.venv/Scripts/python scripts/gate_v2_calibration_report.py
# HTTP:     GET /readiness/gate-v2-calibration?days=90
# Runbook:  docs/runbooks/GATE_V2_CALIBRATOR_RUNBOOK.md
ENABLE_GATE_V2_CALIBRATOR=0

# ---- Reddit PRAW (OPTIONAL, equities-only) ---------------------------------
# POLICY (owner directive, 2026-04-19): Reddit is NOT a trusted futures
# sentiment source. Futures sentiment comes exclusively from Corey Sures'
# Discord #market-updates (see engine/discord/ pipeline). PRAW is gated OFF
# for futures tickers in social_analyst._fetch_reddit_praw — do not remove.
# These env vars only affect equity tickers that happen to use
# DEFAULT_SUBREDDITS, and leaving them unset is the recommended default.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=jarvis-trader/1.0 (social_analyst; read-only)

