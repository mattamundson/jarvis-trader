# JARVIS TRADER — Environment Variables
# Copy to .env and fill in your keys. Never commit .env to git.
#
# Required keys are marked [REQUIRED]. Everything else is optional or has
# a safe default and will degrade gracefully if left blank.

# ── API Security ───────────────────────────────────────────────────────────
# FastAPI X-API-Key header authentication.
# Change this to a strong random key before exposing the engine externally.
# [REQUIRED to protect all API endpoints]
API_KEY=your-api-key-here

# ── LLM (Anthropic) ────────────────────────────────────────────────────────
# Get key from: https://console.anthropic.com/
# [REQUIRED — used by all analyst and trader agents]
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: override which Claude models each agent uses.
# Defaults shown are what config.py uses if these vars are absent.
# ANALYST_MODEL=claude-sonnet-4-6
# TRADER_MODEL=claude-opus-4-6
# FAST_MODEL=claude-haiku-4-5-20251001
# LLM_PROVIDER=anthropic

# ── Interactive Brokers ────────────────────────────────────────────────────
# No API keys needed — connects to IB Gateway running on localhost.
# 4002 = paper trading (default, safe)
# 4001 = live trading — PERMANENTLY BLOCKED in ib_gateway.py
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_PAPER_MODE=True

# ── Paper Trading Config ───────────────────────────────────────────────────
# These map directly to TradingConfig in config.py.
# Override here to change limits without editing code.
LIVE_TRADING_ENABLED=False
REQUIRE_HUMAN_APPROVAL=True
# MAX_DAILY_LOSS_PCT=0.02
# MAX_DRAWDOWN_PCT=0.10
# MAX_CONTRACTS_PER_INSTRUMENT=2
# MAX_OVERNIGHT_CONTRACTS=1
# MAX_SINGLE_ORDER_VALUE=5000.0
# MAX_MARGIN_UTILIZATION=0.40
# PRICE_COLLAR_PCT=0.05
# MAX_POSITION_SIZE_PCT=0.05
# MAX_ORDERS_PER_MINUTE=10
# MAX_CORRELATED_EXPOSURE_PCT=0.20
# CONSECUTIVE_LOSS_HALT=7

# ── Charles Schwab ─────────────────────────────────────────────────────────
# Register app at: https://developer.schwab.com/
# Refresh token expires every 7 days — you'll need to re-auth weekly.
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1

# ── Market Data ────────────────────────────────────────────────────────────
# Polygon.io — https://polygon.io/ (Starter plan $29/mo recommended)
POLYGON_API_KEY=your_polygon_key_here

# Finnhub — https://finnhub.io/ (free tier available)
FINNHUB_API_KEY=your_finnhub_key_here

# Alpaca (optional — for paper trading data only, free)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=True

# StockTwits (optional — used by SocialAnalystAgent for sentiment data)
# Register at: https://api.stocktwits.com/developers/
STOCKTWITS_TOKEN=

# ── Databases (Docker defaults) ────────────────────────────────────────────
POSTGRES_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis_trader
REDIS_URL=redis://localhost:6379
QUESTDB_HOST=localhost
QUESTDB_PORT=9000

# ── WhatsApp Notifications (via Twilio) ────────────────────────────────────
# NOTE: whatsapp.py uses httpx directly (no twilio Python SDK needed).
# 1. Sign up at https://www.twilio.com/
# 2. Enable WhatsApp Sandbox in the Twilio console
# 3. From your phone, text "join <sandbox-word>" to +1 415 523 8886
#
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN are from your Twilio dashboard.
# TWILIO_WHATSAPP_FROM = sandbox number, e.g. whatsapp:+14155238886
# WHATSAPP_TO          = your personal number, e.g. whatsapp:+12125551234
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+1XXXXXXXXXX

# ── Telegram Notifications (optional alternative to WhatsApp) ──────────────
# Create a bot at: https://t.me/botfather
# Get your chat ID at: https://t.me/userinfobot
# If both Telegram and WhatsApp are configured, both will receive alerts.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── TradingView Webhook Security ───────────────────────────────────────────
# Set a random secret string here and include the same value as the "secret"
# field in every TradingView alert JSON payload.
# Leave blank to disable secret validation (not recommended for production).
TRADINGVIEW_WEBHOOK_SECRET=your_secret_here
