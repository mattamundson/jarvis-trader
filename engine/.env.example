# JARVIS TRADER — Environment Variables Template
# Copy to engine/.env and fill in your keys. NEVER commit .env to git.
#
# Sections:
#   TRADING MODE        — Paper vs. Live, autonomy settings
#   IB GATEWAY          — Interactive Brokers connection (paper trading)
#   SAFETY & RISK       — Kill switches, position limits, halt conditions
#   INSTRUMENTS         — Symbols to trade
#   MARKET DATA APIs    — Third-party quote/fundamental data
#   LLM & AGENTS        — Anthropic Claude for trading pipeline
#   DATABASES           — PostgreSQL, Redis, QuestDB (Docker)
#   NOTIFICATIONS       — WhatsApp, Telegram alerts
#   API SECURITY        — Authentication and security

# TRADING MODE
# Paper mode (True) = orders logged, not sent to broker. Live mode (False) = requires LIVE_TRADING_ENABLED=True
PAPER_TRADING=True
PAPER_TRADING_BROKER=IB_GATEWAY
LIVE_TRADING_ENABLED=False
ALLOW_PAPER_SIMULATED_ORDERS=False
REQUIRE_HUMAN_APPROVAL=True
INITIAL_CAPITAL=10000.0

# IB GATEWAY (Paper mode: port 4002, Live: port 4001 blocked)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=2
IBKR_PAPER_MODE=True
IB_ACCOUNT_ID=YOUR_IBKR_ACCOUNT_ID

# SAFETY & RISK PARAMETERS (All hardcoded limits — see safety.md for details)
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
MAX_POSITION_SIZE_PCT=0.05
MAX_CONTRACTS_PER_INSTRUMENT=2
MAX_OVERNIGHT_CONTRACTS=1
MAX_SINGLE_ORDER_VALUE=5000.0
MAX_MARGIN_UTILIZATION=0.40
PRICE_COLLAR_PCT=0.05
MAX_ORDERS_PER_MINUTE=10
MAX_CORRELATED_EXPOSURE_PCT=0.20
CONSECUTIVE_LOSS_HALF_SIZE=3
CONSECUTIVE_LOSS_QUARTER_SIZE=5
CONSECUTIVE_LOSS_HALT=7
CONSECUTIVE_LOSS_HALT_HOURS=24

# INSTRUMENTS TO TRADE (comma-separated)
# Futures: MES (S&P 500 micro), MNQ (NASDAQ micro), MCL (crude oil)
FUTURES_WATCHLIST=MES,MNQ,MCL
# Options: underlying symbols for options trading (if module enabled)
OPTIONS_WATCHLIST=SPY,QQQ,AAPL,TSLA

# MARKET DATA APIs
POLYGON_API_KEY=pk_live_YOUR_POLYGON_KEY_HERE
FRED_API_KEY=YOUR_FRED_API_KEY_HERE
FINNHUB_API_KEY=YOUR_FINNHUB_KEY_HERE
ALPACA_API_KEY=YOUR_ALPACA_KEY_HERE
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_HERE
ALPACA_PAPER=True

# LLM & TRADING AGENTS (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE
LLM_PROVIDER=anthropic
ANALYST_MODEL=claude-sonnet-4-6
TRADER_MODEL=claude-opus-4-6
FAST_MODEL=claude-haiku-4-5-20251001

# DATABASES (Docker Compose stack for multi-instance deployments)
POSTGRES_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis_trader
REDIS_URL=redis://localhost:6379
QUESTDB_HOST=localhost
QUESTDB_PORT=9000

# NOTIFICATIONS (Optional — WhatsApp via Twilio or Telegram)
TWILIO_ACCOUNT_SID=AC_YOUR_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN_HERE
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+1XXXXXXXXXX

# API SECURITY & LOGGING
API_KEY=jarvis-dev-key-change-me
LOG_LEVEL=INFO

# FEATURE FLAGS (Experimental features — enable with caution)
ENABLE_TILT_DETECTION=True
ENABLE_KAIROS=False
ENABLE_SPECULATION=False

# ORCHESTRATOR & PERFORMANCE
DAILY_TARGET=500.0
DATA_DIR=./data

# DASHBOARD (Next.js frontend)
NEXT_PUBLIC_ENGINE_API_KEY=jarvis-dev-key-change-me

# TELEGRAM ALERTS (Alternative to WhatsApp)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Schwab / ThinkorSwim (Charles Schwab Developer API)
# Get credentials at: https://developer.schwab.com
# 1. Create a new app — set callback URL to https://127.0.0.1
# 2. Copy App Key and App Secret below
# 3. Set SCHWAB_READY=true when credentials are configured
# 4. Run POST /schwab/connect to trigger OAuth browser flow (one-time)
# NOTE: Schwab supports equities + options only. Futures route via IBKR.
SCHWAB_APP_KEY=your_schwab_developer_app_key_here
SCHWAB_APP_SECRET=your_schwab_developer_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_READY=false

# SAFETY: Commit .env.example to git (no secrets). NEVER commit .env (real API keys).