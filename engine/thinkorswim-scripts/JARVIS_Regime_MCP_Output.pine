//@version=5
indicator("JARVIS Regime (MCP Output)", overlay=false, max_labels_count=500, max_lines_count=500)

// ─── Inputs ───────────────────────────────────────────────────────────────────
stc_os = input.int(15, "STC Oversold", minval=5, maxval=30)
stc_ob = input.int(83, "STC Overbought", minval=60, maxval=95)
ema_fast = input.int(21, "EMA Fast")
ema_slow = input.int(55, "EMA Slow")
ema_trend = input.int(200, "EMA Trend")
atr_len = input.int(14, "ATR Length")

// ─── Indicators ───────────────────────────────────────────────────────────────
// STC via MACD components
fast_ma = ta.ema(close, 23)
slow_ma = ta.ema(close, 50)
macd = fast_ma - slow_ma
signal = ta.ema(macd, 9)

stoch1 = ta.stoch(macd, macd, macd, 10)
stc = ta.ema(stoch1, 3)

// EMAs
ema21 = ta.ema(close, ema_fast)
ema55 = ta.ema(close, ema_slow)
ema200 = ta.ema(close, ema_trend)

atr = ta.atr(atr_len)
atr_avg = ta.sma(atr, 20)

// ─── 5-Layer Regime Detection ─────────────────────────────────────────────────
// Layer 1: Trend direction (200 EMA slope)
l1_bull = ta.ema(close, ema_trend) > ta.ema(close[5], ema_trend)
l1_bear = ta.ema(close, ema_trend) < ta.ema(close[5], ema_trend)

// Layer 2: Short-term momentum (fast vs slow EMA)
l2_bull = ema21 > ema55
l2_bear = ema21 < ema55

// Layer 3: Volatility regime
l3_expanding = atr > atr_avg * 1.1
l3_compressing = atr < atr_avg * 0.9

// Layer 4: Price structure (recent swing)
lookback = 10
swing_high = ta.highest(high, lookback)
swing_low = ta.lowest(low, lookback)
l4_bull = close > (swing_high + swing_low) / 2
l4_bear = close < (swing_high + swing_low) / 2

// Layer 5: Volume confirmation
vol_avg = ta.sma(volume, 20)
l5_confirmed = volume > vol_avg * 1.1

// ─── Regime Classification ────────────────────────────────────────────────────
bull_layers = (l1_bull ? 1 : 0) + (l2_bull ? 1 : 0) + (l4_bull ? 1 : 0)
bear_layers = (l1_bear ? 1 : 0) + (l2_bear ? 1 : 0) + (l4_bear ? 1 : 0)

regime = l3_compressing and bull_layers <= 2 and bear_layers <= 2 ? "COMPRESSION" :
         bull_layers >= 3 and l5_confirmed ? "TRENDING_BULL" :
         bear_layers >= 3 and l5_confirmed ? "TRENDING_BEAR" :
         bull_layers >= 3 ? "TRENDING_BULL" :
         bear_layers >= 3 ? "TRENDING_BEAR" :
         atr > atr_avg * 1.4 ? "EXHAUSTED" :
         "RANGE_BOUND"

// STC Signal State
stc_state = stc < stc_os ? "OVERSOLD" : stc > stc_ob ? "OVERBOUGHT" : "NEUTRAL"

// ─── Output Table (readable by tradingview-mcp data_get_pine_tables) ──────────
var table t = table.new(position.top_right, 2, 8,
     bgcolor=color.new(color.black, 20), border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "JARVIS Regime", text_color=color.white, bgcolor=color.navy)
    table.cell(t, 1, 0, "Value", text_color=color.white, bgcolor=color.navy)

    table.cell(t, 0, 1, "regime", text_color=color.gray)
    table.cell(t, 1, 1, regime,
         text_color=bull_layers > bear_layers ? color.green :
                    bear_layers > bull_layers ? color.red : color.yellow)

    table.cell(t, 0, 2, "stc_value", text_color=color.gray)
    table.cell(t, 1, 2, str.tostring(math.round(stc, 2)), text_color=color.white)

    table.cell(t, 0, 3, "stc_state", text_color=color.gray)
    table.cell(t, 1, 3, stc_state, text_color=color.white)

    table.cell(t, 0, 4, "layer_1_trend", text_color=color.gray)
    table.cell(t, 1, 4, l1_bull ? "BULL" : l1_bear ? "BEAR" : "NEUTRAL", text_color=color.white)

    table.cell(t, 0, 5, "layer_2_momentum", text_color=color.gray)
    table.cell(t, 1, 5, l2_bull ? "BULL" : l2_bear ? "BEAR" : "NEUTRAL", text_color=color.white)

    table.cell(t, 0, 6, "layer_3_volatility", text_color=color.gray)
    table.cell(t, 1, 6, l3_expanding ? "EXPANDING" : l3_compressing ? "COMPRESSING" : "NORMAL", text_color=color.white)

    table.cell(t, 0, 7, "bull_score", text_color=color.gray)
    table.cell(t, 1, 7, str.tostring(bull_layers) + "/3 | bear:" + str.tostring(bear_layers) + "/3", text_color=color.white)

// Plot for visual reference
plot(stc, "STC", color=stc > stc_ob ? color.red : stc < stc_os ? color.green : color.blue, linewidth=2)
hline(stc_os, "Oversold", color=color.green, linestyle=hline.style_dashed)
hline(stc_ob, "Overbought", color=color.red, linestyle=hline.style_dashed)
