# Ruff configuration for JARVIS TRADER
# High-quality linting and formatting rules for production code

[ruff]
target-version = "py312"
line-length = 120

# Linting rules
select = [
    "E",    # pycodestyle errors
    "W",    # pycodestyle warnings
    "F",    # Pyflakes
    "I",    # isort (import sorting)
    "N",    # pep8-naming
    "UP",   # pyupgrade
    "B",    # flake8-bugbear
    "SIM",  # flake8-simplify
]

ignore = [
    "E501",  # line too long (handled by formatter)
    "W503",  # line break before binary operator
    "B008",  # do not perform function calls in argument defaults
    "SIM105", # use contextlib.suppress
]

# Rules specific to certain paths
[ruff.per-file-ignores]
"**/tests/**" = [
    "F401",  # unused imports in tests
    "F841",  # unused variables in tests
]
"**/conftest.py" = [
    "F401",  # pytest fixtures are often unused in the file they're defined
]

# Import sorting rules (isort)
[ruff.isort]
known-first-party = [
    "engine",
    "agents",
    "risk",
    "backtest",
    "execution",
    "database",
    "api",
    "analytics",
    "data",
]
known-third-party = [
    "fastapi",
    "pydantic",
    "pandas",
    "numpy",
    "sqlalchemy",
    "anthropic",
]
force-single-line = false
lines-between-types = 1

# Naming conventions
[ruff.pep8-naming]
classmethod-decorators = ["classmethod", "pydantic.field_serializer"]
staticmethod-decorators = ["staticmethod"]

# Format configuration (for ruff format)
[ruff.format]
quote-style = "double"
indent-style = "space"
line-ending = "auto"
skip-magic-trailing-comma = false
