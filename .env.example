# JARVIS TRADER — Environment Configuration Template
# Copy this to .env and populate with real values.
# NEVER commit .env — it will be ignored by .gitignore
# Use strong, unique values for all API keys and secrets

# ──────────────────────────────────────────────────────────────────────
# RISK CONTROLS (Safety Layer) — Non-negotiable trading guardrails
# ──────────────────────────────────────────────────────────────────────

# Maximum position size as % of total portfolio (0.05 = 5%)
MAX_POSITION_SIZE_PCT=0.05

# Daily loss threshold — halt trading at -X% P&L
MAX_DAILY_LOSS_PCT=0.02

# Maximum drawdown from equity peak — emergency halt at -X%
MAX_DRAWDOWN_PCT=0.10

# Rate limit: maximum orders per minute
MAX_ORDERS_PER_MINUTE=10

# Maximum correlation exposure — never exceed X% in correlated positions
MAX_CORRELATED_EXPOSURE_PCT=0.20

# Price collar — reject orders >X% away from NBBO
PRICE_COLLAR_PCT=0.05

# Single order value cap — no order > $X
MAX_SINGLE_ORDER_VALUE=5000.0

# Margin utilization cap — never exceed X% of available margin
MAX_MARGIN_UTILIZATION=0.40

# ──────────────────────────────────────────────────────────────────────
# FUTURES-SPECIFIC CONTROLS
# ──────────────────────────────────────────────────────────────────────

# Maximum micro contracts per instrument (MES, MNQ, MCL)
MAX_CONTRACTS_PER_INSTRUMENT=2

# Maximum contracts to hold overnight
MAX_OVERNIGHT_CONTRACTS=1

# ──────────────────────────────────────────────────────────────────────
# CONSECUTIVE LOSS TRACKING & ADAPTIVE POSITION SIZING
# ──────────────────────────────────────────────────────────────────────

# After N consecutive losses, reduce position size to 0.5x
CONSECUTIVE_LOSS_HALF_SIZE=3

# After N consecutive losses, reduce position size to 0.25x
CONSECUTIVE_LOSS_QUARTER_SIZE=5

# After N consecutive losses, halt all trading
CONSECUTIVE_LOSS_HALT=7

# Duration of trading halt (hours) after hitting consecutive loss threshold
CONSECUTIVE_LOSS_HALT_HOURS=24

# ──────────────────────────────────────────────────────────────────────
# TRADING AUTONOMY TIER
# ──────────────────────────────────────────────────────────────────────

# Set to True ONLY after 30-day paper trading validation
# Default: False (paper trading only)
LIVE_TRADING_ENABLED=False

# Require human approval for all live orders (Matt's confirmation)
REQUIRE_HUMAN_APPROVAL=True

# ──────────────────────────────────────────────────────────────────────
# BROKER: INTERACTIVE BROKERS (IB Gateway)
# ──────────────────────────────────────────────────────────────────────

# IB Gateway host (usually 127.0.0.1 for local connection)
IBKR_HOST=127.0.0.1

# IB Gateway port: 4001=live trading, 4002=paper trading
IBKR_PORT=4002

# Client ID for IB Gateway connection (must match TWS/Gateway config)
IBKR_CLIENT_ID=1

# Always start in paper mode for safety
IBKR_PAPER_MODE=True

# ──────────────────────────────────────────────────────────────────────
# BROKER: CHARLES SCHWAB (OAuth)
# ──────────────────────────────────────────────────────────────────────

# Schwab app key from OAuth app registration
SCHWAB_APP_KEY=your_schwab_app_key_here

# Schwab app secret (KEEP SECURE)
SCHWAB_APP_SECRET=your_schwab_app_secret_here

# Schwab OAuth callback URL (must match registered URI)
SCHWAB_CALLBACK_URL=https://127.0.0.1

# ──────────────────────────────────────────────────────────────────────
# MARKET DATA PROVIDERS
# ──────────────────────────────────────────────────────────────────────

# Polygon.io API key (for equity and forex market data)
# Get from: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key_here

# Finnhub API key (alternative equity data source)
# Get from: https://finnhub.io/dashboard/api-key
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpaca Markets API key
ALPACA_API_KEY=your_alpaca_api_key_here

# Alpaca Markets secret key (KEEP SECURE)
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Use Alpaca paper trading (True) or live (False)
ALPACA_PAPER=True

# ──────────────────────────────────────────────────────────────────────
# CRYPTO (Kraken or Freqtrade)
# ──────────────────────────────────────────────────────────────────────

# Comma-separated list of market modules to activate. Empty = all
# non-futures modules stay dormant (historical default). Example:
# ENABLED_MARKETS=futures,crypto
ENABLED_MARKETS=

# Enable the crypto market module. Also requires CRYPTO_BACKEND to be set
# and "crypto" to appear in ENABLED_MARKETS above. All three must line up
# before CryptoMarketModule.is_enabled() returns True.
CRYPTO_ENABLED=False

# Crypto module backend: "freqtrade" (default) or "kraken"
# - freqtrade: delegates to running Freqtrade instance at localhost:8080
# - kraken: drives kraken-cli (Rust binary) directly. Requires `kraken`
#   on PATH. Set KRAKEN_LIVE_ENABLED=True to switch from paper to live.
CRYPTO_BACKEND=freqtrade

# Kraken spot API credentials (only needed when CRYPTO_BACKEND=kraken
# AND KRAKEN_LIVE_ENABLED=True). Kraken requires SEPARATE keys for
# spot vs futures trading — create both in the Kraken security console.
KRAKEN_SPOT_API_KEY=
KRAKEN_SPOT_API_SECRET=

# Kraken perpetual / inverse futures API credentials
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# Flip to True to enable live Kraken trading. Default False routes all
# orders to kraken-cli's built-in paper engine regardless of API keys.
# Mirrors IBKR live-gating pattern — NEVER set True before paper validation
# and WhatsApp approval flow is wired.
KRAKEN_LIVE_ENABLED=False

# ──────────────────────────────────────────────────────────────────────
# JARVIS API SECURITY
# ──────────────────────────────────────────────────────────────────────

# FastAPI X-API-Key header authentication (use strong random value)
# All requests to /v1/* endpoints require: -H "X-API-Key: <this_value>"
API_KEY=change-me-to-a-strong-random-key-minimum-32-chars

# ──────────────────────────────────────────────────────────────────────
# LLM: ANTHROPIC (Claude API)
# ──────────────────────────────────────────────────────────────────────

# Anthropic API key (for direct Claude access if Gateway not available)
# Get from: https://console.anthropic.com/account/keys
# Pattern: sk-ant-api03-...
ANTHROPIC_API_KEY=sk-ant-api03-your-real-key-here

# LLM provider identifier
LLM_PROVIDER=anthropic

# ──────────────────────────────────────────────────────────────────────
# LLM: AGENT MODELS (Claude variants for different tasks)
# ──────────────────────────────────────────────────────────────────────

# Model for analyst agents (research, data analysis)
ANALYST_MODEL=claude-sonnet-4-6

# Model for trader/risk/fund manager agents (decision-making)
TRADER_MODEL=claude-opus-4-7

# Fast, cheaper model for simple operations
FAST_MODEL=claude-haiku-4-5-20251001

# ──────────────────────────────────────────────────────────────────────
# DATABASES
# ──────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
POSTGRES_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis_trader

# Redis connection string
# Format: redis://password@host:port (password optional for local dev)
REDIS_URL=redis://localhost:6379

# QuestDB time-series database host
QUESTDB_HOST=localhost

# QuestDB HTTP server port (9000 is default)
QUESTDB_PORT=9000

# ──────────────────────────────────────────────────────────────────────
# NOTIFICATIONS: TWILIO (WhatsApp alerts)
# ──────────────────────────────────────────────────────────────────────

# Twilio Account SID (find in: https://www.twilio.com/console)
# Format: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token (KEEP SECURE — find in: https://www.twilio.com/console)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio WhatsApp sender number (must be verified in Twilio console)
# Format: +1234567890 (E.164 format)
TWILIO_WHATSAPP_FROM=+1234567890

# Target WhatsApp number for alerts (Matt's number)
# Format: +1234567890 (E.164 format)
WHATSAPP_TO=+1234567890

# ──────────────────────────────────────────────────────────────────────
# INSTRUMENTS TO TRADE
# ──────────────────────────────────────────────────────────────────────

# Micro futures contracts to trade (comma-separated)
# Common: MES (E-mini S&P 500), MNQ (E-mini Nasdaq 100), MCL (Micro Crude Oil)
FUTURES_WATCHLIST=MES,MNQ,MCL

# Equity symbols for options trading (comma-separated)
OPTIONS_WATCHLIST=SPY,QQQ,AAPL,TSLA

# ──────────────────────────────────────────────────────────────────────
# VAULT AUTOMATION (Obsidian second brain)
# ──────────────────────────────────────────────────────────────────────
# Overnight Claude-over-vault jobs adapted from DamiDefi's "9 Things My
# Obsidian Vault Does While I Sleep". All jobs default OFF — set a flag to 1
# to arm it, then `pm2 reload engine/ecosystem.config.js`. Flags are read
# fresh at run time (no engine restart needed). See
# docs/runbooks/VAULT_AUTOMATION.md.

# Vault root. Defaults to ~/my-vault if unset. Must match the Obsidian vault
# the Discord deep-analyzer writes to. Set per-machine (Windows uses a path
# like C:/Users/<you>/second-brain).
JARVIS_VAULT_ROOT=

# 06:00 CT synthesis brief (connections / pattern / contradiction / best
# capture) → 00-Inbox/brief-YYYY-MM-DD.md. PM2 job: jarvis-vault-synthesis.
ENABLE_VAULT_SYNTHESIS=0
VAULT_SYNTHESIS_MODEL=claude-sonnet-4-6
VAULT_SYNTHESIS_DAYS=7

# 06:30 CT wikilink lint (broken [[links]] + orphan notes, no LLM) →
# 00-Inbox/lint-YYYY-MM-DD.md. PM2 job: jarvis-vault-lint.
ENABLE_VAULT_LINT=0

# 07:00 CT thesis contradiction scan (02-Theses vs 01-Sources) →
# 00-Inbox/contradictions-YYYY-MM-DD.md. PM2 job: jarvis-vault-contradiction.
ENABLE_VAULT_CONTRADICTION=0
VAULT_CONTRADICTION_MODEL=claude-sonnet-4-6
VAULT_CONTRADICTION_DAYS=30

# 00:00 CT vault GitHub backup. Requires the vault to be its OWN git repo with
# a remote (one-time: cd $JARVIS_VAULT_ROOT && git init && git remote add
# origin <private-url>). PM2 job: jarvis-vault-backup.
ENABLE_VAULT_BACKUP=0
VAULT_BACKUP_BRANCH=main

# 03:00 CT Discord bookmark render target (already active in the lifespan
# scheduler). Defaults to the Windows second-brain path in main.py if unset.
BOOKMARK_VAULT_DIR=

# ──────────────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ──────────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────
# PAPER TRADING MODE (30-day forward test)
# ──────────────────────────────────────────────────────────────────────

# Enable paper trading mode (prevents live order submission)
# Set to True during 30-day validation period
PAPER_TRADING=True
