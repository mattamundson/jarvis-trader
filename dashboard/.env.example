# =============================================================================
# Dashboard environment — copy to .env.local (local dev) or set in Vercel (prod).
# =============================================================================
#
# There are TWO groups of vars:
#   1. Server-side proxy vars — read by app/api/engine/[...path]/route.ts and
#      next.config.ts. These are what actually make engine calls work. NOT
#      exposed to the browser. Required in production (Vercel).
#   2. Browser fallback vars (NEXT_PUBLIC_*) — used only by the direct WebSocket
#      client (hooks/useWebSocket.ts) and legacy fallbacks. REST calls do NOT
#      need these; they go through the server proxy above.
#
# See DEPLOY_VERCEL.md for the full production setup (ngrok tunnel + 3-layer auth).

# --- 1. Server-side proxy (required in prod) ---------------------------------

# Canonical engine base URL the proxy forwards to. Local: the engine on :8010.
# Prod (Vercel): the ngrok static domain, no trailing slash. The proxy also
# accepts ENGINE_URL_INTERNAL as an alias. If neither is set it falls back to
# http://localhost:8010 — which is DEAD on Vercel, so you MUST set this in prod.
ENGINE_INTERNAL_URL=http://localhost:8010

# Engine X-API-Key. Must match API_KEY in engine/.env. The proxy also accepts
# NEXT_PUBLIC_ENGINE_API_KEY as a fallback (see below), but prefer this
# server-only var in prod so the key never enters the browser bundle.
# Mark Sensitive in Vercel.
ENGINE_API_KEY=jarvis-dev-key-change-me

# ngrok tunnel basic-auth, as user:pass, matching the credentials block in
# ngrok.yml. The proxy base64-encodes this into an Authorization: Basic header.
# Required in prod (the tunnel 401s without it); leave UNSET for local dev where
# the proxy targets 127.0.0.1:8010 directly with no tunnel. Mark Sensitive in Vercel.
# ENGINE_TUNNEL_BASIC_AUTH=jarvis:change-me

# --- 2. Browser fallback (WebSocket / legacy only) ---------------------------

# Engine base URL for the direct WS client and origin fallback. REST does not
# use this. Safe to leave as localhost for local dev.
NEXT_PUBLIC_ENGINE_URL=http://localhost:8010

# Fallback engine key for the proxy if ENGINE_API_KEY is unset. Because it is
# NEXT_PUBLIC_, it IS exposed to the browser — prefer ENGINE_API_KEY in prod.
NEXT_PUBLIC_ENGINE_API_KEY=jarvis-dev-key-change-me

# --- 3. External master-api service (optional) -------------------------------

# Separate external master-api service (see AGENTS.md "External service:
# master-api"), read only by app/api/master/[...path]/route.ts. Server-only
# (no NEXT_PUBLIC_ prefix) — never sent to the browser.
# MASTER_API_URL=http://127.0.0.1:8030
# MASTER_API_KEY=
