# Copy to .env.local and adjust. Must match engine API_KEY (see engine/.env.example).
# Server-only (no NEXT_PUBLIC_ prefix) — read by app/api/engine/[...path]/route.ts
# and never sent to the browser.
ENGINE_API_KEY=jarvis-dev-key-change-me
# Canonical engine base URL. Dashboard requests route through the Next proxy to this backend.
NEXT_PUBLIC_ENGINE_URL=http://localhost:8010