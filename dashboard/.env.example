# Copy to .env.local and adjust. Must match engine API_KEY (see engine/.env.example).
# Server-only (no NEXT_PUBLIC_ prefix) — read by app/api/engine/[...path]/route.ts
# and the /ws/pipeline rewrite in next.config.ts, and never sent to the browser.
ENGINE_API_KEY=jarvis-dev-key-change-me
# Canonical engine base URL. Dashboard requests route through the Next proxy to this backend.
NEXT_PUBLIC_ENGINE_URL=http://localhost:8010
# Optional. Only needed when a deployment connects lib/pipeline_ws.ts directly
# to the engine (NEXT_PUBLIC_ENGINE_URL set to a remote/tunnel host — see
# DEPLOY_VERCEL.md "Known limitation — WebSocket pages"). Leave unset for the
# same-origin case; the /ws/pipeline proxy rewrite injects ENGINE_API_KEY
# server-side instead. No default — never hardcode a fallback here.
# NEXT_PUBLIC_ENGINE_API_KEY=

# Optional. Separate external master-api service (see AGENTS.md "External
# service: master-api"), read only by app/api/master/[...path]/route.ts.
# Server-only (no NEXT_PUBLIC_ prefix) — never sent to the browser.
# MASTER_API_URL=http://127.0.0.1:8030
# MASTER_API_KEY=