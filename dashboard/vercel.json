{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "deploy/dashboard": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/check-flow",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/watchdog-health",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 9 * * 1"
    }
  ]
}
